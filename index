<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The International School of Azerbaijan Behaviour Tracker</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- React & ReactDOM -->
    <script src="https://unpkg.com/react@17/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@17/umd/react-dom.development.js"></script>
    
    <!-- Babel 7 for modern JSX/JS transpilation -->
    <script src="https://unpkg.com/@babel/standalone@7.23.9/babel.min.js"></script>
    
    <!-- Firebase SDKs (v8 Compat) -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
    
    <!-- Mammoth.js for DOCX processing -->
    <script src="https://cdn.jsdelivr.net/npm/mammoth@1.6.0/mammoth.browser.min.js"></script>
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .dropzone { border: 2px dashed #cbd5e1; transition: all 0.2s ease; }
        .dropzone.dragging { border-color: #3b82f6; background-color: #eff6ff; transform: scale(1.01); }
        .animate-spin-slow { animation: spin 3s linear infinite; }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .material-btn { padding: 4px 8px; border-radius: 8px; font-size: 0.75rem; font-weight: 700; transition: all 0.2s; border: 1px solid transparent; }
        .material-btn.missing { background-color: #fee2e2; border-color: #ef4444; color: #b91c1c; }
        .material-btn.present { background-color: #f1f5f9; border-color: #e2e8f0; color: #64748b; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 10px; }
        .day-badge { font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: 800; background: #e2e8f0; color: #475569; }
        .google-btn { background: white; color: #444; border-radius: 5px; border: 1px solid #ddd; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; font-weight: bold; transition: all 0.2s; }
        .google-btn:hover { box-shadow: 0 2px 4px 0 rgba(0,0,0,0.25); cursor: pointer; }
    </style>
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
</head>
<body>
    <div id="root"></div>

    <script type="text/babel" data-type="module">
        // =====================================================================
        // 🚨 YOUR FIREBASE CONFIGURATION GOES HERE 🚨
        // Replace the empty brackets {} below with your Firebase config object.
        // It should look something like: { apiKey: "...", authDomain: "...", ... }
        // =====================================================================
        const myFirebaseConfig = {};
        // =====================================================================

        const { useState, useEffect, useMemo, useRef } = React;

        // --- Gemini API Configuration ---
        const apiKey = ""; 
        const GEMINI_MODEL = "gemini-2.5-flash-preview-09-2025";

        const callGemini = async (prompt, systemInstruction = "") => {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${apiKey}`;
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: { parts: [{ text: systemInstruction }] }
            };
            let delay = 1000;
            for (let i = 0; i < 5; i++) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    const result = await response.json();
                    return result.candidates?.[0]?.content?.parts?.[0]?.text || "No response from AI.";
                } catch (error) {
                    if (i === 4) throw error;
                    await new Promise(res => setTimeout(res, delay));
                    delay *= 2;
                }
            }
        };

        // --- Reusable UI Elements ---
        const EditableField = ({ initialValue, onSave, textClass }) => {
            const [isEditing, setIsEditing] = useState(false);
            const [value, setValue] = useState(initialValue);
            const inputRef = useRef(null);
            useEffect(() => { setValue(initialValue); }, [initialValue]);
            useEffect(() => { if (isEditing) { inputRef.current?.focus(); inputRef.current?.select(); } }, [isEditing]);
            const handleSave = () => {
                if (value.trim() && value.trim() !== initialValue) onSave(value.trim());
                setIsEditing(false);
            };
            if (isEditing) return <input ref={inputRef} type="text" value={value} onChange={(e) => setValue(e.target.value)} onBlur={handleSave} onKeyDown={(e) => e.key === 'Enter' && handleSave()} className={`${textClass} bg-yellow-50 border-blue-400 border-2 rounded px-1 outline-none`} />;
            return <span onClick={() => setIsEditing(true)} className={`${textClass} cursor-pointer hover:bg-yellow-50 rounded transition`}>{initialValue}</span>;
        };

        // --- Main App Component ---
        function App() {
            const getAppId = () => typeof __app_id !== 'undefined' ? __app_id : 'tisa-tracker-v3';
            const getFirebaseConfig = () => { 
                if (myFirebaseConfig && Object.keys(myFirebaseConfig).length > 0) return myFirebaseConfig;
                try { return typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {}; } catch (e) { return {}; } 
            };
            const formatDate = (date) => { const d = new Date(date); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };

            // State
            const [firebaseState, setFirebaseState] = useState({ db: null, auth: null });
            const [user, setUser] = useState(null);
            const [isAuthReady, setIsAuthReady] = useState(false);
            const [setupComplete, setSetupComplete] = useState(false);
            const [loadingSetup, setLoadingSetup] = useState(true);
            const [missingDbConfig, setMissingDbConfig] = useState(false);
            const [classes, setClasses] = useState([]);
            const [selectedClassId, setSelectedClassId] = useState(null);
            const [userSettings, setUserSettings] = useState({ 
                appTitle: "The International School of Azerbaijan", 
                schoolLogo: "https://placehold.co/100x40/0ea5e9/ffffff?text=TISA",
                scheduleStartDate: formatDate(new Date())
            });
            const [noSchoolDays, setNoSchoolDays] = useState([]);
            const [students, setStudents] = useState([]);
            const [dailyData, setDailyData] = useState({});
            const [selectedDate, setSelectedDate] = useState(new Date());
            const [searchQuery, setSearchQuery] = useState('');
            const [newStudentName, setNewStudentName] = useState('');
            const [newStudentEmail, setNewStudentEmail] = useState('');
            
            // Modals State
            const [modals, setModals] = useState({ class: false, noSchool: false, ai: false, bulkPaste: false, bulkClass: false, delete: null, history: null });
            const [bulkPasteText, setBulkPasteText] = useState('');
            const [bulkClassText, setBulkClassText] = useState('');
            const [aiContent, setAiContent] = useState({ title: '', text: '', loading: false, copied: false });

            const appId = getAppId();
            const formattedDate = useMemo(() => formatDate(selectedDate), [selectedDate]);
            const materials = ["Calculator", "Pen/Pencil", "Laptop", "Notebook"];
            const behaviorSteps = [
                { level: 0, title: 'Good Standing', color: 'bg-green-500', text: 'text-green-700' },
                { level: 1, title: 'Verbal Warning', color: 'bg-yellow-400', text: 'text-yellow-700' },
                { level: 2, title: 'Class Referral', color: 'bg-orange-500', text: 'text-orange-700' },
                { level: 3, title: 'Contact Parents', color: 'bg-red-600', text: 'text-red-700' }
            ];

            // 10 Day Cycle Logic
            const cycleInfo = useMemo(() => {
                if (!userSettings.scheduleStartDate) return { day: null, isWeekend: false };
                const start = new Date(userSettings.scheduleStartDate.replace(/-/g, '/'));
                const target = new Date(selectedDate);
                start.setHours(0,0,0,0); target.setHours(0,0,0,0);
                const dayOfWeek = target.getDay();
                if (dayOfWeek === 0 || dayOfWeek === 6) return { day: null, isWeekend: true };
                if (target < start) return { day: null, isWeekend: false };
                let workDayCount = 0;
                let cur = new Date(start);
                while (cur <= target) {
                    const d = cur.getDay();
                    if (d !== 0 && d !== 6) workDayCount++;
                    cur.setDate(cur.getDate() + 1);
                }
                const cycleDay = ((workDayCount - 1) % 10) + 1;
                return { day: cycleDay, isWeekend: false };
            }, [selectedDate, userSettings.scheduleStartDate]);

            // Database Handlers (Hoisted inside App)
            const handleUpdateClassSchedule = async (classId, dayIdx, value) => {
                const cls = classes.find(c => c.id === classId);
                const newSchedule = [...(cls.schedule || Array(10).fill(true))];
                newSchedule[dayIdx] = value;
                await firebaseState.db.doc(`/artifacts/${appId}/users/${user.uid}/classes/${classId}`).update({ schedule: newSchedule });
            };

            const handleAddClass = async (name) => {
                if (!name.trim()) return;
                await firebaseState.db.collection(`/artifacts/${appId}/users/${user.uid}/classes`).add({ 
                    name: name.trim(), created: new Date().toISOString(), schedule: Array(10).fill(true)
                });
            };

            const batchAddClasses = async (names) => {
                if (!names.length) return;
                const batch = firebaseState.db.batch();
                names.forEach(name => {
                    const ref = firebaseState.db.collection(`/artifacts/${appId}/users/${user.uid}/classes`).doc();
                    batch.set(ref, { name: name.trim(), created: new Date().toISOString(), schedule: Array(10).fill(true) });
                });
                await batch.commit();
            };

            const handleUpdateSettings = async (newSet) => {
                await firebaseState.db.doc(`/artifacts/${appId}/users/${user.uid}/settings/main`).set(newSet, { merge: true });
                setUserSettings(prev => ({ ...prev, ...newSet }));
            };

            const updateDailyRecord = async (studentId, data) => {
                const ref = firebaseState.db.doc(`/artifacts/${appId}/users/${user.uid}/classes/${selectedClassId}/dailyRecords/${formattedDate}`);
                await ref.set({ studentData: { [studentId]: data } }, { merge: true });
            };

            const toggleMaterial = async (studentId, material) => {
                const current = dailyData[studentId]?.missingMaterials || [];
                const updated = current.includes(material) ? current.filter(m => m !== material) : [...current, material];
                await updateDailyRecord(studentId, { missingMaterials: updated });
            };

            const handleAddStudent = async (name, email) => {
                if (!selectedClassId || !name.trim()) return;
                await firebaseState.db.collection(`/artifacts/${appId}/users/${user.uid}/classes/${selectedClassId}/students`).add({ 
                    name: name.trim(), email: email.trim(), added: new Date().toISOString() 
                });
            };

            const handleUpdateStudentInfo = async (studentId, updates) => {
                await firebaseState.db.doc(`/artifacts/${appId}/users/${user.uid}/classes/${selectedClassId}/students/${studentId}`).update(updates);
            };

            const batchAddStudents = async (lines) => {
                if (!selectedClassId || !lines.length) return;
                const batch = firebaseState.db.batch();
                lines.forEach(line => {
                    const [namePart, ...emailParts] = line.split(',');
                    const name = namePart ? namePart.trim() : '';
                    const email = emailParts.length ? emailParts.join(',').trim() : '';
                    if (!name) return;
                    
                    const ref = firebaseState.db.collection(`/artifacts/${appId}/users/${user.uid}/classes/${selectedClassId}/students`).doc();
                    batch.set(ref, { name, email, added: new Date().toISOString() });
                });
                await batch.commit();
            };

            // Init Firebase
            useEffect(() => {
                const init = async () => {
                    const config = getFirebaseConfig();
                    
                    // Verify if config exists before initializing
                    if (!config || !config.apiKey) {
                        setMissingDbConfig(true);
                        setLoadingSetup(false);
                        return;
                    }

                    if (!firebase.apps.length) firebase.initializeApp(config);
                    const auth = firebase.auth();
                    const db = firebase.firestore();
                    setFirebaseState({ db, auth });
                    auth.onAuthStateChanged(async (u) => {
                        if (u) { setUser(u); } 
                        else { await auth.signInAnonymously(); }
                        setIsAuthReady(true);
                    });
                };
                init();
            }, []);

            // Real-time Listeners
            useEffect(() => {
                if (!isAuthReady || !user || !firebaseState.db) return;
                const db = firebaseState.db;
                const base = `/artifacts/${appId}/users/${user.uid}`;
                const unsubSettings = db.doc(`${base}/settings/main`).onSnapshot(doc => {
                    if (doc.exists) { setUserSettings(prev => ({...prev, ...doc.data()})); setSetupComplete(true); }
                    setLoadingSetup(false);
                });
                const unsubClasses = db.collection(`${base}/classes`).onSnapshot(snap => {
                    const data = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                    setClasses(data);
                    if (!selectedClassId && data.length > 0) setSelectedClassId(data[0].id);
                });
                const unsubDays = db.collection(`${base}/noSchoolDays`).onSnapshot(snap => setNoSchoolDays(snap.docs.map(d => d.id)));
                return () => { unsubSettings(); unsubClasses(); unsubDays(); };
            }, [isAuthReady, user, firebaseState.db]);

            useEffect(() => {
                if (!user || !selectedClassId || !firebaseState.db) return;
                const unsub = firebaseState.db.doc(`/artifacts/${appId}/users/${user.uid}/classes/${selectedClassId}/dailyRecords/${formattedDate}`)
                    .onSnapshot(doc => setDailyData(doc.exists ? (doc.data().studentData || {}) : {}));
                return () => unsub();
            }, [user, selectedClassId, formattedDate, firebaseState.db]);

            useEffect(() => {
                if (!user || !selectedClassId || !firebaseState.db) return;
                const unsub = firebaseState.db.collection(`/artifacts/${appId}/users/${user.uid}/classes/${selectedClassId}/students`)
                    .onSnapshot(snap => setStudents(snap.docs.map(d => ({ id: d.id, ...d.data() }))));
                return () => unsub();
            }, [user, selectedClassId, firebaseState.db]);

            const handleGoogleSignIn = async () => {
                const provider = new firebase.auth.GoogleAuthProvider();
                try { await firebaseState.auth.signInWithPopup(provider); } 
                catch (e) { await firebaseState.auth.signInAnonymously(); }
            };

            const fetchStudentHistory = async (student) => {
                const snap = await firebaseState.db.collection(`/artifacts/${appId}/users/${user.uid}/classes/${selectedClassId}/dailyRecords`).get();
                const history = [];
                snap.forEach(doc => {
                    const data = doc.data().studentData?.[student.id];
                    if (data) history.push({ date: doc.id, ...data });
                });
                setModals({...modals, history: { student, records: history.sort((a,b) => b.date.localeCompare(a.date)) }});
            };

            const getAIHelp = async (type, student) => {
                setAiContent({ title: `✨ AI Assistant`, text: '', loading: true, copied: false });
                setModals({...modals, ai: true});
                let prompt = "", system = "You are a teacher at TISA in Azerbaijan.";
                const day = dailyData[student?.id] || {};
                if (type === 'strategy') prompt = `Student: ${student.name}. Status: ${behaviorSteps[day.behaviorLevel || 0].title}. Bathroom trips: ${day.bathroom || 0}. Missing: ${(day.missingMaterials || []).join(',')}. Give 3 strategies.`;
                else if (type === 'email') prompt = `Draft a TISA parent email for ${student.name}. Behavior level: ${behaviorSteps[day.behaviorLevel || 0].title}. Notes: ${day.comment || 'N/A'}.`;
                try {
                    const res = await callGemini(prompt, system);
                    setAiContent(p => ({ ...p, text: res, loading: false }));
                } catch (e) { setAiContent(p => ({ ...p, text: "AI error.", loading: false })); }
            };

            // Missing Database Screen
            if (missingDbConfig) return (
                <div className="min-h-screen bg-slate-100 flex items-center justify-center p-4">
                    <div className="max-w-xl w-full bg-white p-10 rounded-3xl shadow-xl text-center border-t-8 border-red-500">
                        <div className="text-red-500 mb-4 flex justify-center">
                            <svg className="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        </div>
                        <h1 className="text-2xl font-bold mb-4 text-slate-800">Database Connection Missing</h1>
                        <p className="text-slate-600 mb-6 text-left leading-relaxed">
                            Your app is live, but it doesn't know where to save your data! You need to connect it to a free Google Firebase database so your student records are saved securely.
                        </p>
                        <div className="bg-slate-50 border border-slate-200 p-5 rounded-2xl text-left text-sm text-slate-700 mb-8">
                            <p className="font-bold mb-2">How to fix this:</p>
                            <ol className="list-decimal pl-5 space-y-2">
                                <li>Follow the guide to create a free Firebase Web App.</li>
                                <li>Copy your unique <code>firebaseConfig</code> code.</li>
                                <li>Open your <code>index.html</code> file on GitHub and click the pencil icon to edit.</li>
                                <li>Paste your config into the <code>myFirebaseConfig</code> brackets at the top of the code (around line 39).</li>
                                <li>Commit your changes and wait 2 minutes!</li>
                            </ol>
                        </div>
                    </div>
                </div>
            );

            if (loadingSetup) return <div className="flex h-screen items-center justify-center bg-slate-50"><div className="animate-spin h-10 w-10 border-4 border-blue-500 border-t-transparent rounded-full"></div></div>;

            if (!user) return (
                <div className="min-h-screen bg-slate-50 flex items-center justify-center p-4">
                    <div className="max-w-md w-full bg-white p-10 rounded-3xl shadow-xl text-center">
                        <img src="https://placehold.co/120x50/0ea5e9/ffffff?text=TISA" className="mx-auto mb-6 rounded" />
                        <h1 className="text-2xl font-bold mb-4">TISA Tracker</h1>
                        <p className="text-slate-500 mb-8">Sign in with your Google account to secure your data.</p>
                        <button onClick={handleGoogleSignIn} className="google-btn w-full py-3 px-6 shadow-sm border">Sign in with Google</button>
                    </div>
                </div>
            );

            if (!setupComplete) return (
                <div className="min-h-screen bg-sky-50 flex items-center justify-center p-4">
                    <div className="w-full max-w-lg bg-white p-8 rounded-2xl shadow-xl">
                        <h1 className="text-2xl font-bold text-blue-900 mb-6 text-center tracking-tight">TISA Tracker Setup</h1>
                        <div className="space-y-4">
                            <div><label className="block text-sm font-semibold mb-1">School Name</label><input type="text" className="w-full p-3 border rounded-xl" value={userSettings.appTitle} onChange={e => setUserSettings({...userSettings, appTitle: e.target.value})} /></div>
                            <div><label className="block text-sm font-semibold mb-1">Cycle Day 1 Start Date</label><input type="date" className="w-full p-3 border rounded-xl" value={userSettings.scheduleStartDate} onChange={e => setUserSettings({...userSettings, scheduleStartDate: e.target.value})} /></div>
                            <LogoUploader onLogoChange={url => setUserSettings({...userSettings, schoolLogo: url})} />
                            <button onClick={() => handleUpdateSettings(userSettings)} className="w-full py-4 bg-blue-600 text-white font-bold rounded-xl shadow-lg mt-4">Confirm Settings</button>
                        </div>
                    </div>
                </div>
            );

            const filteredStudents = students.filter(s => s.name.toLowerCase().includes(searchQuery.toLowerCase())).sort((a,b) => a.name.localeCompare(b.name));
            const isScheduledToday = classes.find(c => c.id === selectedClassId)?.schedule?.[cycleInfo.day - 1] ?? true;

            return (
                <div className="min-h-screen">
                    <header className="bg-white border-b sticky top-0 z-40 px-4 py-3 shadow-sm flex flex-col md:flex-row justify-between items-center gap-4">
                        <div className="flex items-center gap-4">
                            <img src={userSettings.schoolLogo} className="h-10 rounded shadow-sm" />
                            <div>
                                <EditableField initialValue={userSettings.appTitle} onSave={val => handleUpdateSettings({appTitle: val})} textClass="text-lg font-bold text-slate-800" />
                                {cycleInfo.day && <span className="day-badge ml-2 uppercase">DAY {cycleInfo.day}</span>}
                            </div>
                        </div>
                        <div className="flex items-center gap-2">
                            <select className="bg-slate-100 p-2 rounded-lg font-medium border-none outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer" value={selectedClassId || ''} onChange={e => setSelectedClassId(e.target.value)}>
                                {classes.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
                                {classes.length === 0 && <option>No Classes</option>}
                            </select>
                            <button onClick={() => setModals({...modals, class: true})} className="p-2 text-slate-600 font-semibold hover:bg-slate-100 rounded transition">Classes</button>
                            <button onClick={() => setModals({...modals, noSchool: true})} className="p-2 text-slate-600 font-semibold hover:bg-slate-100 rounded transition">Calendar</button>
                            <input type="date" value={formattedDate} onChange={e => setSelectedDate(new Date(e.target.value))} className="p-2 bg-slate-100 rounded-lg border-none outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </header>

                    <main className="max-w-7xl mx-auto px-4 py-8">
                        <div className="flex flex-col lg:flex-row justify-between items-center mb-8 gap-4">
                            <div className="flex items-center gap-4 w-full md:w-auto">
                                <h2 className="text-2xl font-bold text-slate-800 whitespace-nowrap">Classroom</h2>
                                <input type="text" placeholder="Filter..." className="p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500 w-full md:w-48 outline-none" value={searchQuery} onChange={e => setSearchQuery(e.target.value)} />
                                <button onClick={() => setModals({...modals, bulkPaste: true})} className="px-4 py-2 bg-blue-50 text-blue-700 font-bold rounded-xl border border-blue-100 whitespace-nowrap transition hover:bg-blue-100">✨ Bulk Students</button>
                            </div>
                            <form onSubmit={(e) => { e.preventDefault(); if(newStudentName) { handleAddStudent(newStudentName, newStudentEmail); setNewStudentName(''); setNewStudentEmail(''); } }} className="flex gap-2 w-full md:w-auto">
                                <input type="text" className="flex-1 p-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-blue-500" placeholder="Student name..." value={newStudentName} onChange={e => setNewStudentName(e.target.value)} />
                                <input type="email" className="w-1/3 p-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-blue-500" placeholder="Email..." value={newStudentEmail} onChange={e => setNewStudentEmail(e.target.value)} />
                                <button type="submit" className="bg-blue-600 text-white px-6 py-2 rounded-xl font-bold shadow-sm hover:bg-blue-700 active:scale-95 transition">+</button>
                            </form>
                        </div>

                        {!isScheduledToday || cycleInfo.isWeekend ? (
                            <div className="bg-white rounded-3xl p-20 text-center shadow-sm border border-slate-100 text-slate-400 font-bold text-xl uppercase tracking-widest">
                                {cycleInfo.isWeekend ? "No School (Weekend)" : `No Class Scheduled (Day ${cycleInfo.day})`}
                            </div>
                        ) : (
                            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {filteredStudents.map(student => {
                                    const day = dailyData[student.id] || { behaviorLevel: 0, bathroom: 0, missingMaterials: [], comment: '' };
                                    return (
                                        <div key={student.id} className="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-col group relative hover:shadow-md transition duration-200">
                                            <div className="flex justify-between items-start mb-4">
                                                <div className="flex-1 min-w-0 mr-2">
                                                    <h3 className="font-bold text-slate-800 truncate">{student.name}</h3>
                                                    <EditableField 
                                                        initialValue={student.email || 'add email...'} 
                                                        onSave={val => handleUpdateStudentInfo(student.id, {email: val})} 
